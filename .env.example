MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=drop_space
OWNER_USERNAME=owner
OWNER_PASSWORD=replace-with-a-strong-private-passphrase
PORT=3000
HOST=0.0.0.0
COOKIE_SECURE=false
# Optional: DNS servers for Node.js SRV lookups, e.g. 8.8.8.8,8.8.4.4
DNS_SERVERS=8.8.8.8,8.8.4.4
